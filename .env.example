NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only
# Generate with: openssl rand -base64 32
SILPO_TOKEN_ENCRYPTION_KEY=replace_with_base64_32_byte_key
AI_PROVIDER=deepseek
AI_API_KEY=replace_with_deepseek_api_key
AI_BASE_URL=https://api.deepseek.com
AI_NORMALIZER_MODEL=deepseek-v4-flash
AI_PLANNER_MODEL=deepseek-v4-flash
AI_SUPERVISOR_MODEL=deepseek-v4-flash
# Local-only agent observer; never expose this secret publicly.
AI_AGENT_HARNESS_SECRET=replace_with_local_dev_secret
# Server-only secret for the internal agent worker route.
AGENT_WORKER_SECRET=replace_with_worker_secret
# Optional Supabase Edge dispatcher URL. Without it, local development runs the worker directly.
AGENT_DISPATCHER_URL=
AGENT_DISPATCHER_SECRET=replace_with_dispatcher_secret
